func _build_language_switch() -> void:
    var box := HBoxContainer.new()
    box.set_anchors_preset(Control.PRESET_TOP_RIGHT)
    box.offset_left = -126
    box.offset_top = 18
    box.offset_right = -18
    box.offset_bottom = 52
    box.add_theme_constant_override("separation", 4)
    box.z_index = 100
    add_child(box)
    for entry in [["en", "EN"], ["cs", "CZ"]]:
        var button := Button.new()
        button.text = str(entry[1])
        button.custom_minimum_size = Vector2(50, 30)
        button.focus_mode = Control.FOCUS_ALL
        button.set_meta("locale_code", str(entry[0]))
        button.pressed.connect(_set_language.bind(str(entry[0])))
        box.add_child(button)
    box.set_meta("language_switch", true)
    _refresh_language_switch(box)

func _set_language(code: String) -> void:
    if localizer.language == code:
        return
    localizer.set_language(code)
    for child in get_children():
        if child is HBoxContainer and child.has_meta("language_switch"):
            _refresh_language_switch(child)
    _rerender_current_view()

func _refresh_language_switch(box: HBoxContainer) -> void:
    for child in box.get_children():
        if child is Button:
            var active: bool = str(child.get_meta("locale_code")) == str(localizer.language)
            child.add_theme_color_override("font_color", Color("0e1117") if active else _color("semantic.color.text.primary", Color.WHITE))
            child.add_theme_stylebox_override("normal", _box(_color("game.focus.controller.ringColor", Color("7b85ff")) if active else Color(0.05,0.07,0.10,0.72), _color("semantic.color.border.default", Color("4b5565")), 14, 1))
            child.add_theme_stylebox_override("hover", _box(_color("game.focus.controller.ringColor", Color("7b85ff")), Color.TRANSPARENT, 14, 0))
            child.add_theme_stylebox_override("focus", _box(Color.TRANSPARENT, _color("game.focus.controller.ringColor", Color("7b85ff")), 14, int(_number("game.focus.controller.ringWidth", 3))))

func _rerender_current_view() -> void:
    match current_view:
        "menu": _show_menu()
        "gameplay": _show_gameplay()
        "load": _show_load()
        "new": _show_new_expedition()
        "inventory": _show_inventory()
        "quests": _show_quests()
        "dialog": _show_dialog()
        "settings": _show_settings()
        "trace": _show_system_trace()
        _: _show_menu()

func _localize_stage() -> void:
    if stage == null or localizer.language == "en":
        return
    _localize_node(stage)

func _localize_node(node: Node) -> void:
    if node is Label:
        node.text = _translate_multiline(node.text)
    elif node is Button:
        node.text = _translate_multiline(node.text)
    for child in node.get_children():
        _localize_node(child)

func _translate_multiline(text: String) -> String:
    var lines := text.split("\n", true)
    var translated := PackedStringArray()
    for line in lines:
        var raw := str(line)
        var core := raw.strip_edges()
        if core.is_empty():
            translated.append(raw)
            continue
        var start := raw.find(core)
        var prefix := raw.substr(0, start) if start > 0 else ""
        var suffix_start := start + core.length()
        var suffix := raw.substr(suffix_start) if suffix_start < raw.length() else ""
        translated.append(prefix + localizer.t(core) + suffix)
    return "\n".join(translated)

func _screen_margin(left: int, top: int, right: int, bottom: int) -> MarginContainer:
    var margin := MarginContainer.new()
    margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    margin.add_theme_constant_override("margin_left", left)
    margin.add_theme_constant_override("margin_top", top)
    margin.add_theme_constant_override("margin_right", right)
    margin.add_theme_constant_override("margin_bottom", bottom)
    return margin

func _center_overlay(title_text: String, kicker_text: String, minimum: Vector2) -> PanelContainer:
    var dim := ColorRect.new()
    dim.color = Color(0.02, 0.025, 0.04, 0.62)
    dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    stage.add_child(dim)

    var viewport_size: Vector2 = get_viewport_rect().size
    var safe_size: Vector2 = Vector2(
        min(minimum.x, max(420.0, viewport_size.x - 64.0)),
        min(minimum.y, max(280.0, viewport_size.y - 64.0))
    )
    var panel := _panel_container(title_text)
    panel.custom_minimum_size = safe_size
    panel.size = safe_size
    panel.position = (viewport_size - safe_size) / 2.0
    panel.clip_contents = true
    stage.add_child(panel)

    var margin := panel.get_child(0) as MarginContainer
    var content := panel.get_meta("content") as VBoxContainer
    margin.remove_child(content)
    var scroll := ScrollContainer.new()
    scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
    scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
    margin.add_child(scroll)
    content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    scroll.add_child(content)

    var kicker := _kicker(kicker_text)
    content.add_child(kicker)
    return panel

func _panel_container(title_text: String) -> PanelContainer:
    var panel := PanelContainer.new()
    panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    var panel_bg := _color("component.panel.background", Color("202633"))
    panel_bg.a = 0.94
    var panel_border := Color.WHITE if high_contrast_enabled and current_view == "gameplay" else _color("component.panel.border", Color("4b5565"))
    var panel_border_width := 2 if high_contrast_enabled and current_view == "gameplay" else 1
    panel.add_theme_stylebox_override("panel", _box(
        panel_bg,
        panel_border,
        int(_number("component.panel.radius", 12)),
        panel_border_width
    ))
    var margin := MarginContainer.new()
    var pad := int(_number("component.panel.padding", 24))
    margin.add_theme_constant_override("margin_left", pad)
    margin.add_theme_constant_override("margin_right", pad)
    margin.add_theme_constant_override("margin_top", pad)
    margin.add_theme_constant_override("margin_bottom", pad)
    panel.add_child(margin)
    var column := VBoxContainer.new()
    column.add_theme_constant_override("separation", int(_number("semantic.spacing.md", 16)))
    margin.add_child(column)
    var heading := Label.new()
    heading.text = title_text
    heading.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    heading.add_theme_font_size_override("font_size", 20)
    column.add_child(heading)
    panel.set_meta("content", column)
    return panel

