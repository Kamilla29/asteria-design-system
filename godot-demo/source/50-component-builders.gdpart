func _action_button(text: String, callback: Callable, selected: bool) -> Button:
    var button := Button.new()
    button.text = text
    button.focus_mode = Control.FOCUS_ALL
    _style_action_button(button, selected)
    button.pressed.connect(callback)
    return button

func _small_nav_button(text: String, callback: Callable) -> Button:
    var button := Button.new()
    button.text = text
    button.custom_minimum_size = Vector2(110, 64)
    button.focus_mode = Control.FOCUS_ALL
    button.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    var nav_border := Color.WHITE if high_contrast_enabled else _color("semantic.color.border.default", Color("4b5565"))
    button.add_theme_stylebox_override("normal", _box(Color(0.05,0.07,0.10,0.78), nav_border, 9, 2 if high_contrast_enabled else 1))
    button.add_theme_stylebox_override("hover", _box(Color(0.08,0.10,0.18,0.88), _color("game.focus.controller.ringColor", Color("7b85ff")), 9, 2))
    button.add_theme_stylebox_override("focus", _box(Color(0.08,0.10,0.18,0.88), _color("game.focus.controller.ringColor", Color("7b85ff")), 9, int(_number("game.focus.controller.ringWidth", 3))))
    button.pressed.connect(callback)
    return button

func _save_slot(title_text: String, subtitle: String, time_text: String, callback: Callable) -> Button:
    var button := Button.new()
    button.text = "%s\n%s                                      %s" % [localizer.t(title_text), localizer.t(subtitle), time_text]
    button.alignment = HORIZONTAL_ALIGNMENT_LEFT
    button.custom_minimum_size = Vector2(0, 76)
    button.focus_mode = Control.FOCUS_ALL
    button.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    button.add_theme_stylebox_override("normal", _box(Color.TRANSPARENT, _color("semantic.color.border.default", Color("4b5565")), 9, 1))
    button.add_theme_stylebox_override("hover", _box(Color(0.48,0.52,1.0,0.08), _color("game.focus.controller.ringColor", Color("7b85ff")), 9, 2))
    button.add_theme_stylebox_override("focus", _box(Color(0.48,0.52,1.0,0.08), _color("game.focus.controller.ringColor", Color("7b85ff")), 9, 3))
    button.pressed.connect(callback)
    return button

func _quest_button(title_text: String, subtitle: String, callback: Callable) -> Button:
    var button := Button.new()
    button.text = "%s\n%s" % [title_text, subtitle]
    button.alignment = HORIZONTAL_ALIGNMENT_LEFT
    button.custom_minimum_size = Vector2(0, 82)
    button.focus_mode = Control.FOCUS_ALL
    button.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    button.add_theme_stylebox_override("normal", _box(Color.TRANSPARENT, _color("semantic.color.border.default", Color("4b5565")), 8, 1))
    button.add_theme_stylebox_override("hover", _box(Color(0.48,0.52,1.0,0.08), _color("game.focus.controller.ringColor", Color("7b85ff")), 8, 2))
    button.add_theme_stylebox_override("focus", _box(Color(0.48,0.52,1.0,0.08), _color("game.focus.controller.ringColor", Color("7b85ff")), 8, 3))
    button.pressed.connect(callback)
    return button

func _hud_panel(label_text: String, value: float, critical: bool) -> PanelContainer:
    var panel := _panel_container(label_text)
    panel.custom_minimum_size = Vector2(245, 104)
    var content := panel.get_meta("content") as VBoxContainer
    var row := HBoxContainer.new()
    content.add_child(row)
    var value_label := Label.new()
    value_label.text = "%d%%" % int(value)
    value_label.add_theme_color_override("font_color", _color("game.hud.critical.color", Color("d14b4b")) if critical else _color("semantic.color.text.primary", Color.WHITE))
    row.add_child(value_label)
    var bar := ProgressBar.new()
    bar.value = value
    bar.max_value = 100
    bar.show_percentage = false
    bar.custom_minimum_size = Vector2(170, 14)
    _style_progress(bar, critical)
    content.add_child(bar)
    if critical:
        critical_bar = bar
    return panel

func _style_progress(bar: ProgressBar, critical: bool) -> void:
    bar.add_theme_stylebox_override("background", _box(_color("component.progress.track", Color("4b5565")), Color.TRANSPARENT, int(_number("component.progress.radius", 999)), 0))
    var fill := _color("component.progress.danger", Color("d14b4b")) if critical else _color("component.progress.value", Color("5b67f1"))
    bar.add_theme_stylebox_override("fill", _box(fill, Color.TRANSPARENT, int(_number("component.progress.radius", 999)), 0))

func _setting_stepper_row(title_text: String, subtitle: String, value_percent: int) -> HBoxContainer:
    var row := HBoxContainer.new()
    row.custom_minimum_size = Vector2(0, 70)
    var text := VBoxContainer.new()
    text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    row.add_child(text)
    var title := Label.new()
    title.text = title_text
    title.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    text.add_child(title)
    text.add_child(_muted(subtitle, 12))

    var controls := HBoxContainer.new()
    controls.add_theme_constant_override("separation", 8)
    row.add_child(controls)
    var minus := _compact_setting_button("−")
    minus.pressed.connect(_change_interface_scale.bind(-10))
    controls.add_child(minus)
    var value := Label.new()
    value.text = "%d%%" % value_percent
    value.custom_minimum_size = Vector2(58, 34)
    value.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    value.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    value.add_theme_color_override("font_color", _color("game.focus.controller.ringColor", Color("7b85ff")))
    controls.add_child(value)
    var plus := _compact_setting_button("+")
    plus.pressed.connect(_change_interface_scale.bind(10))
    controls.add_child(plus)
    return row

func _setting_toggle_row(title_text: String, subtitle: String, enabled: bool, callback: Callable) -> HBoxContainer:
    var row := HBoxContainer.new()
    row.custom_minimum_size = Vector2(0, 70)
    var text := VBoxContainer.new()
    text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    row.add_child(text)
    var title := Label.new()
    title.text = title_text
    title.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    text.add_child(title)
    text.add_child(_muted(subtitle, 12))

    var toggle := Button.new()
    toggle.text = "ON" if enabled else "OFF"
    toggle.custom_minimum_size = Vector2(92, 36)
    toggle.focus_mode = Control.FOCUS_ALL
    var active_color := _color("game.focus.controller.ringColor", Color("7b85ff"))
    var inactive_color := _color("semantic.color.border.default", Color("4b5565"))
    toggle.add_theme_color_override("font_color", Color("0e1117") if enabled else _color("semantic.color.text.primary", Color.WHITE))
    toggle.add_theme_stylebox_override("normal", _box(active_color if enabled else Color(0.05,0.07,0.10,0.72), inactive_color, 18, 1))
    toggle.add_theme_stylebox_override("hover", _box(active_color, Color.TRANSPARENT, 18, 0))
    toggle.add_theme_stylebox_override("focus", _box(Color.TRANSPARENT, active_color, 18, int(_number("game.focus.controller.ringWidth", 3))))
    toggle.pressed.connect(callback)
    row.add_child(toggle)
    return row

func _compact_setting_button(text_value: String) -> Button:
    var button := Button.new()
    button.text = text_value
    button.custom_minimum_size = Vector2(38, 34)
    button.focus_mode = Control.FOCUS_ALL
    button.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    button.add_theme_stylebox_override("normal", _box(Color(0.05,0.07,0.10,0.72), _color("semantic.color.border.default", Color("4b5565")), 8, 1))
    button.add_theme_stylebox_override("hover", _box(Color(0.08,0.10,0.18,0.88), _color("game.focus.controller.ringColor", Color("7b85ff")), 8, 2))
    button.add_theme_stylebox_override("focus", _box(Color.TRANSPARENT, _color("game.focus.controller.ringColor", Color("7b85ff")), 8, int(_number("game.focus.controller.ringWidth", 3))))
    return button

