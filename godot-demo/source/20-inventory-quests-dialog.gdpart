func _show_inventory() -> void:
    current_view = "inventory"
    _clear_stage()
    var panel := _center_overlay("Inventory", "EQUIPMENT", Vector2(980, 570))
    var content := panel.get_meta("content") as VBoxContainer

    var layout := HBoxContainer.new()
    layout.size_flags_vertical = Control.SIZE_EXPAND_FILL
    layout.add_theme_constant_override("separation", 28)
    content.add_child(layout)

    var slots := GridContainer.new()
    slots.columns = 3
    slots.custom_minimum_size = Vector2(470, 0)
    slots.add_theme_constant_override("h_separation", int(_number("component.inventorySlot.gap", 8)))
    slots.add_theme_constant_override("v_separation", int(_number("component.inventorySlot.gap", 8)))
    layout.add_child(slots)

    for i in range(inventory_items.size()):
        var slot := Button.new()
        slot.text = str(i + 1) + "\n" + inventory_items[i]["name"]
        slot.custom_minimum_size = Vector2(145, 110)
        _style_inventory_slot(slot, i == selected_item)
        slot.pressed.connect(_select_inventory_item.bind(i))
        slots.add_child(slot)
    var locked := Button.new()
    locked.text = "◇\nLocked"
    locked.disabled = true
    locked.custom_minimum_size = Vector2(145, 110)
    _style_inventory_slot(locked, false)
    locked.modulate.a = _number("game.state.lockedOpacity", 0.45)
    slots.add_child(locked)

    var detail := VBoxContainer.new()
    detail.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    detail.add_theme_constant_override("separation", 12)
    layout.add_child(detail)
    var item = inventory_items[selected_item]
    detail.add_child(_kicker(str(item["rarity"])))
    var item_name_label := Label.new()
    item_name_label.text = str(item["name"])
    item_name_label.add_theme_font_size_override("font_size", 30)
    item_name_label.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    detail.add_child(item_name_label)
    detail.add_child(_section_text(str(item["description"])))
    detail.add_child(_muted(str(item["stat"]), 14))
    var equip_text := "Equipped" if equipped_item == str(item["name"]) else "Equip"
    var equip := _action_button(equip_text, _equip_selected_item, true)
    detail.add_child(equip)
    detail.add_child(_action_button("Back to game", _show_gameplay, false))
    if slots.get_child_count() > 0:
        (slots.get_child(0) as Button).grab_focus()

func _select_inventory_item(index: int) -> void:
    selected_item = index
    _show_inventory()

func _equip_selected_item() -> void:
    equipped_item = str(inventory_items[selected_item]["name"])
    _rumble(0.09, 0.20, 0.48)
    _show_inventory()

func _show_quests() -> void:
    current_view = "quests"
    _clear_stage()
    var panel := _center_overlay("Quest Log", "NAVIGATION · 3 ACTIVE", Vector2(980, 570))
    var content := panel.get_meta("content") as VBoxContainer
    var layout := HBoxContainer.new()
    layout.size_flags_vertical = Control.SIZE_EXPAND_FILL
    layout.add_theme_constant_override("separation", 28)
    content.add_child(layout)

    var list := VBoxContainer.new()
    list.custom_minimum_size = Vector2(360, 0)
    list.add_theme_constant_override("separation", 8)
    layout.add_child(list)
    var first: Button = null
    for quest_name in quest_data.keys():
        var q = quest_data[quest_name]
        var button := _quest_button(str(quest_name), str(q["detail"]), _select_quest.bind(str(quest_name)))
        list.add_child(button)
        if first == null:
            first = button

    var detail := VBoxContainer.new()
    detail.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    detail.add_theme_constant_override("separation", 12)
    layout.add_child(detail)
    var selected_name := tracked_quest if quest_data.has(tracked_quest) else "The Glass Meridian"
    var selected = quest_data[selected_name]
    detail.add_child(_kicker("SELECTED QUEST"))
    var title := Label.new()
    title.text = selected_name
    title.add_theme_font_size_override("font_size", 30)
    detail.add_child(title)
    detail.add_child(_section_text(str(selected["detail"])))
    var bar := ProgressBar.new()
    bar.value = float(selected["progress"])
    bar.max_value = 100
    bar.show_percentage = true
    bar.custom_minimum_size = Vector2(0, 20)
    _style_progress(bar, false)
    detail.add_child(bar)
    detail.add_child(_action_button("Track quest", _track_selected_quest.bind(selected_name), true))
    detail.add_child(_action_button("Back to game", _show_gameplay, false))
    if first != null:
        first.grab_focus()

func _select_quest(quest_name: String) -> void:
    tracked_quest = quest_name
    _show_quests()

func _track_selected_quest(quest_name: String) -> void:
    tracked_quest = quest_name
    tracked_detail = str(quest_data[quest_name]["distance"])
    _show_gameplay()

func _show_dialog() -> void:
    current_view = "dialog"
    _clear_stage()
    var character := Label.new()
    character.text = "\n\n\nLYRA\nVENN"
    character.position = Vector2(85, 130)
    character.size = Vector2(280, 400)
    character.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    character.add_theme_font_size_override("font_size", 38)
    character.add_theme_color_override("font_color", Color(0.48,0.52,1.0,0.48))
    stage.add_child(character)

    var dialog := _panel_container("LYRA VENN")
    dialog.position = Vector2(370, 410)
    dialog.size = Vector2(675, 230)
    stage.add_child(dialog)
    var content := dialog.get_meta("content") as VBoxContainer
    var line := _section_text("“The route is stable for now. If the prism starts pulsing red, do not cross the gate.”")
    line.add_theme_font_size_override("font_size", 19)
    content.add_child(line)
    var row := HBoxContainer.new()
    row.add_theme_constant_override("separation", 10)
    content.add_child(row)
    var ask := _action_button("Ask about the prism", _dialog_prism, true)
    row.add_child(ask)
    row.add_child(_action_button("Leave", _show_gameplay, false))
    ask.grab_focus()

func _dialog_prism() -> void:
    _clear_stage()
    var dialog := _panel_container("LYRA VENN")
    dialog.position = Vector2(300, 350)
    dialog.size = Vector2(745, 280)
    stage.add_child(dialog)
    var content := dialog.get_meta("content") as VBoxContainer
    content.add_child(_section_text("“The prism reacts to unstable routes before our instruments do. Red means the gate is already collapsing.”"))
    var end := _action_button("Understood", _show_gameplay, true)
    content.add_child(end)
    end.grab_focus()

