func _kicker(text: String) -> Label:
    var label := Label.new()
    label.text = text
    label.add_theme_color_override("font_color", _color("component.navigationItem.indicator", Color("5b67f1")))
    label.add_theme_font_size_override("font_size", 11)
    return label

func _muted(text: String, size: int) -> Label:
    var label := Label.new()
    label.text = text
    label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    label.add_theme_color_override("font_color", _color("semantic.color.text.secondary", Color("cbd2dc")))
    label.add_theme_font_size_override("font_size", size)
    return label

func _centered_muted(text: String, size: int) -> Label:
    var label := _muted(text, size)
    label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    return label

func _section_text(text: String) -> Label:
    return _muted(text, 14)

func _token_status_label() -> Label:
    var label := Label.new()
    label.text = "✓ Runtime token loading succeeded"
    label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    label.add_theme_color_override("font_color", _color("semantic.color.status.success", Color("249a62")))
    return label

func _style_action_button(button: Button, selected: bool) -> void:
    button.custom_minimum_size = Vector2(170, _number("component.action.height", 40))
    button.add_theme_color_override("font_color", _color("component.action.text.default", Color("0e1117")) if selected else _color("semantic.color.text.primary", Color.WHITE))
    button.add_theme_color_override("font_hover_color", _color("component.action.text.default", Color("0e1117")))
    button.add_theme_color_override("font_pressed_color", _color("component.action.text.default", Color("0e1117")))
    var radius := int(_number("component.action.radius", 8))
    var normal_color := _color("component.action.background.selected", Color("7b85ff")) if selected else Color(0.05,0.07,0.10,0.62)
    var normal_border := Color.TRANSPARENT if selected else _color("semantic.color.border.default", Color("4b5565"))
    button.add_theme_stylebox_override("normal", _box(normal_color, normal_border, radius, 1 if not selected else 0))
    button.add_theme_stylebox_override("hover", _box(_color("component.action.background.selected", Color("7b85ff")), Color.TRANSPARENT, radius, 0))
    button.add_theme_stylebox_override("pressed", _box(_color("component.action.background.pressed", Color("4651d8")), Color.TRANSPARENT, radius, 0))
    button.add_theme_stylebox_override("focus", _box(Color.TRANSPARENT, _color("game.focus.controller.ringColor", Color("7b85ff")), radius, int(_number("game.focus.controller.ringWidth", 3))))

func _style_inventory_slot(slot: Button, selected: bool) -> void:
    slot.add_theme_color_override("font_color", _color("semantic.color.text.primary", Color.WHITE))
    var border := _color("component.inventorySlot.border.selected", Color("7b85ff")) if selected else _color("component.inventorySlot.border.default", Color("4b5565"))
    slot.add_theme_stylebox_override("normal", _box(_color("component.inventorySlot.background", Color("202633")), border, int(_number("component.inventorySlot.radius", 8)), 2 if selected else 1))
    slot.add_theme_stylebox_override("hover", _box(_color("component.inventorySlot.background", Color("202633")), _color("game.focus.controller.ringColor", Color("7b85ff")), int(_number("component.inventorySlot.radius", 8)), 3))
    slot.add_theme_stylebox_override("focus", _box(Color.TRANSPARENT, _color("game.focus.controller.ringColor", Color("7b85ff")), int(_number("component.inventorySlot.radius", 8)), 3))

func _start_critical_pulse() -> void:
    if critical_bar == null:
        return
    critical_bar.pivot_offset = critical_bar.size * 0.5
    var duration := _number("game.hud.critical.pulseDuration", 0.32)
    var target_scale := _number("game.hud.critical.pulseScale", 1.06)
    var tween := create_tween().set_loops()
    tween.tween_property(critical_bar, "scale", Vector2.ONE * target_scale, duration * 0.5).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
    tween.tween_property(critical_bar, "scale", Vector2.ONE, duration * 0.5).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

func _box(bg: Color, border: Color, radius: int, border_width: int) -> StyleBoxFlat:
    var box := StyleBoxFlat.new()
    box.bg_color = bg
    box.border_color = border
    box.set_border_width_all(border_width)
    box.set_corner_radius_all(radius)
    return box

func _color(path: String, fallback: Color) -> Color:
    var value = tokens.get_token(path, fallback)
    return value if value is Color else fallback

func _number(path: String, fallback: float) -> float:
    var value = tokens.get_token(path, fallback)
    if value is int or value is float:
        return float(value)
    return fallback
