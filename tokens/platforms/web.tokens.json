{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Web adapter. Same-path tokens override the shared core; web.* tokens add web-only capabilities.",
  "web": {
    "breakpoint": {
      "$type": "dimension",
      "sm": { "$value": { "value": 640, "unit": "px" } },
      "md": { "$value": { "value": 768, "unit": "px" } },
      "lg": { "$value": { "value": 1024, "unit": "px" } },
      "xl": { "$value": { "value": 1280, "unit": "px" } }
    },
    "focus": {
      "ringWidth": { "$value": { "value": 2, "unit": "px" }, "$type": "dimension" },
      "ringOffset": { "$value": { "value": 2, "unit": "px" }, "$type": "dimension" }
    },
    "interaction": { "hoverOpacity": { "$value": 0.9, "$type": "number" } }
  },
  "component": {
    "action": { "background": { "hover": { "$value": "{primitive.color.brand.400}", "$type": "color" } } },
    "input": {
      "background": { "$value": "{semantic.color.background.elevated}", "$type": "color" },
      "text": { "$value": "{semantic.color.text.primary}", "$type": "color" },
      "border": {
        "default": { "$value": "{semantic.color.border.default}", "$type": "color" },
        "focus": { "$value": "{semantic.color.border.focus}", "$type": "color" },
        "error": { "$value": "{semantic.color.status.danger}", "$type": "color" }
      },
      "height": { "$value": "{semantic.size.control}", "$type": "dimension" },
      "radius": { "$value": "{semantic.radius.control}", "$type": "dimension" },
      "paddingInline": { "$value": "{semantic.spacing.sm}", "$type": "dimension" }
    },
    "link": {
      "text": {
        "default": { "$value": "{semantic.color.action.primary.base}", "$type": "color" },
        "hover": { "$value": "{primitive.color.brand.600}", "$type": "color" }
      }
    }
  }
}
